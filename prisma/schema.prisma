// Personal Shopper Management System — data model.
//
// Phases 1-3 (order lifecycle, money, fulfillment) are fully modelled here so the
// schema settles once. WhatsApp tables (Phase 4) are included but unused until the
// BSP integration lands; nothing outside lib/whatsapp/ should touch them before then.
//
// Money is Decimal(12,2) in MYR. Prisma returns Decimal instances, which cannot be
// passed to Client Components — the query helpers in src/lib/queries/ serialize
// every monetary field to a number before it leaves the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  SHOPPER
}

/// The order lifecycle, in the order a real order moves through it.
enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAYMENT_VERIFIED
  PURCHASING
  PURCHASED
  IN_CARGO
  ARRIVED_MY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  EWALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PurchaseItemStatus {
  PENDING
  PURCHASED
  UNAVAILABLE
  WRONG_VARIANT
}

enum CargoStatus {
  PREPARING
  IN_TRANSIT
  ARRIVED
  CLOSED
}

/// How a cargo batch's total cost is spread across the orders inside it.
enum AllocationMethod {
  EQUAL
  WEIGHT
  ITEM_COUNT
  MANUAL
}

enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

enum ExpenseCategory {
  SHIPPING
  CARGO
  PACKAGING
  TRANSPORT
  FEES
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  OTHER
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ordersCreated     Order[]              @relation("OrderCreatedBy")
  statusChanges     OrderStatusHistory[] @relation("StatusChangedBy")
  paymentsVerified  Payment[]            @relation("PaymentVerifiedBy")
  purchasesMade     PurchaseItem[]       @relation("PurchasedBy")
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  name           String
  whatsappNumber String   @unique @map("whatsapp_number")
  tiktok         String?
  instagram      String?
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  state          String?
  postcode       String?
  country        String   @default("Malaysia")
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders        Order[]
  conversations WhatsAppConversation[]

  @@index([name])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  category      String?
  supplier      String?
  purchasePrice Decimal  @default(0) @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  images        String[] @default([])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([name])
  @@index([category])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  color     String?
  size      String?
  skuSuffix String?  @map("sku_suffix")
  stockNote String?  @map("stock_note")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Orders — the hub of the model
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  /// Human-facing reference, e.g. PS-000001. The default is evaluated by
  /// Postgres from the `order_number_seq` sequence created in the initial
  /// migration, so concurrent inserts can never collide. Never set it by hand.
  orderNumber String      @unique @default(dbgenerated("('PS-' || lpad(nextval('order_number_seq')::text, 6, '0'))")) @map("order_number")
  customerId  String      @map("customer_id")
  status      OrderStatus @default(NEW)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  cargoFee    Decimal @default(0) @map("cargo_fee") @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)

  notes           String?
  purchaseBatchId String? @map("purchase_batch_id")
  cargoBatchId    String? @map("cargo_batch_id")
  createdById     String  @map("created_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deliveredAt DateTime? @map("delivered_at")

  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  purchaseBatch PurchaseBatch?       @relation(fields: [purchaseBatchId], references: [id], onDelete: SetNull)
  cargoBatch    CargoBatch?          @relation(fields: [cargoBatchId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  cargoOrders   CargoOrder[]
  shipments     Shipment[]
  expenses      Expense[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([purchaseBatchId])
  @@index([cargoBatchId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  variantId    String? @map("variant_id")
  qty          Int     @default(1)
  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)
  purchaseCost Decimal @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  purchaseItems PurchaseItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments (Phase 2)
// ---------------------------------------------------------------------------

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @map("order_id")
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?     @map("paid_at")
  verifiedById String?       @map("verified_by")
  verifiedAt   DateTime?     @map("verified_at")
  note         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User?            @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  receipts   PaymentReceipt[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentReceipt {
  id         String   @id @default(cuid())
  paymentId  String   @map("payment_id")
  fileUrl    String   @map("file_url")
  fileName   String?  @map("file_name")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_receipts")
}

// ---------------------------------------------------------------------------
// Sourcing — Bangkok purchase trips (Phase 2)
// ---------------------------------------------------------------------------

model PurchaseBatch {
  id        String   @id @default(cuid())
  label     String
  tripDate  DateTime @map("trip_date")
  notes     String?
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]
  items  PurchaseItem[]

  @@index([tripDate])
  @@map("purchase_batches")
}

model PurchaseItem {
  id           String             @id @default(cuid())
  batchId      String             @map("batch_id")
  orderItemId  String             @map("order_item_id")
  status       PurchaseItemStatus @default(PENDING)
  actualCost   Decimal?           @map("actual_cost") @db.Decimal(12, 2)
  store        String?
  receiptUrl   String?            @map("receipt_url")
  purchasedById String?           @map("purchased_by")
  purchasedAt  DateTime?          @map("purchased_at")
  note         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch       PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  purchasedBy User?         @relation("PurchasedBy", fields: [purchasedById], references: [id], onDelete: SetNull)

  @@unique([batchId, orderItemId])
  @@index([batchId])
  @@index([status])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------------
// Cargo — Bangkok to Malaysia (Phase 2)
// ---------------------------------------------------------------------------

model CargoBatch {
  id               String           @id @default(cuid())
  label            String
  origin           String           @default("Bangkok")
  destination      String           @default("Malaysia")
  shipDate         DateTime?        @map("ship_date")
  expectedArrival  DateTime?        @map("expected_arrival")
  actualArrival    DateTime?        @map("actual_arrival")
  status           CargoStatus      @default(PREPARING)
  totalCost        Decimal          @default(0) @map("total_cost") @db.Decimal(12, 2)
  allocationMethod AllocationMethod @default(WEIGHT) @map("allocation_method")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders      Order[]
  cargoOrders CargoOrder[]

  @@index([status])
  @@map("cargo_batches")
}

model CargoOrder {
  id             String   @id @default(cuid())
  cargoBatchId   String   @map("cargo_batch_id")
  orderId        String   @map("order_id")
  /// Kilograms.
  weight         Decimal? @db.Decimal(10, 3)
  allocatedCost  Decimal  @default(0) @map("allocated_cost") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cargoBatch CargoBatch @relation(fields: [cargoBatchId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([cargoBatchId, orderId])
  @@index([orderId])
  @@map("cargo_orders")
}

// ---------------------------------------------------------------------------
// Fulfillment (Phase 3)
// ---------------------------------------------------------------------------

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @map("order_id")
  courier        String         @default("J&T")
  trackingNumber String?        @map("tracking_number")
  /// Kilograms.
  weight         Decimal?       @db.Decimal(10, 3)
  cost           Decimal        @default(0) @db.Decimal(12, 2)
  status         ShipmentStatus @default(PENDING)
  bookedAt       DateTime?      @map("booked_at")
  deliveredAt    DateTime?      @map("delivered_at")
  note           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model Expense {
  id       String          @id @default(cuid())
  orderId  String?         @map("order_id")
  category ExpenseCategory @default(OTHER)
  amount   Decimal         @db.Decimal(12, 2)
  note     String?
  date     DateTime        @default(now())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([date])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// WhatsApp (Phase 4 — tables exist, integration lands later)
// ---------------------------------------------------------------------------

model WhatsAppConversation {
  id            String    @id @default(cuid())
  customerId    String?   @map("customer_id")
  phoneNumber   String    @unique @map("phone_number")
  lastMessageAt DateTime? @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages WhatsAppMessage[]

  @@index([customerId])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  body           String?
  mediaUrl       String?          @map("media_url")
  /// Provider-side id, used to de-duplicate webhook replays.
  waMessageId    String?          @unique @map("wa_message_id")
  status         MessageStatus    @default(QUEUED)
  sentAt         DateTime         @default(now()) @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("whatsapp_messages")
}

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  body      String
  variables String[] @default([])
  active    Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  diff      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
