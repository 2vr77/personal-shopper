# Postgres — matches docker-compose.yml. Swap for a Neon/Supabase URL to move off local Docker.
DATABASE_URL="postgresql://shopper:shopper@localhost:5433/personal_shopper?schema=public"

# Signs the session JWT. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-32-byte-random-string"

# WhatsApp (Phase 4) — leave unset to run in disconnected mode (messages are
# logged, not delivered). Once you onboard a BSP, set WHATSAPP_PROVIDER to its
# name and add the provider under lib/whatsapp/providers/.
# WHATSAPP_PROVIDER=""

# Arbitrary string you choose; Meta's webhook verification handshake echoes it
# back to prove you own this endpoint. Required once a real webhook is pointed
# here — safe to leave unset while disconnected.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# AI-Assisted Order Extraction (Phase 5) — optional. If unset, the extraction
# feature will be disabled. Get your API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=""
